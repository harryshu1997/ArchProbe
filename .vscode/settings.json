{
    // "C_Cpp.intelliSenseEngine": "disabled",
    "cmake.useCMakePresets": "auto",
    // Copy compile_commands.json to the build folder to enable clangd to work on different platforms
    "cmake.copyCompileCommands": "${workspaceRoot}/build/compile_commands.json",
